<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Progress section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/widget_progress_bg">

            <TextView
                android:id="@+id/widget_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0%"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#4A90D9"
                android:fontFamily="sans-serif-medium" />

        </FrameLayout>

        <TextView
            android:id="@+id/widget_completed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0/0"
            android:textSize="11sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@drawable/widget_divider" />

    <!-- Task list section -->
    <LinearLayout
        android:id="@+id/widget_task_list"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Задачи на сегодня"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.03" />

        <!-- Task 1 -->
        <LinearLayout
            android:id="@+id/widget_task_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <View
                android:id="@+id/widget_task_dot_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_low" />

            <TextView
                android:id="@+id/widget_task_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="#1A1A1A"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_task_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="10sp"
                android:textColor="#888888"
                android:fontFamily="sans-serif"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:id="@+id/widget_task_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <View
                android:id="@+id/widget_task_dot_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_low" />

            <TextView
                android:id="@+id/widget_task_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="#1A1A1A"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_task_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="10sp"
                android:textColor="#888888"
                android:fontFamily="sans-serif"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Task 3 -->
        <LinearLayout
            android:id="@+id/widget_task_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <View
                android:id="@+id/widget_task_dot_3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_low" />

            <TextView
                android:id="@+id/widget_task_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="#1A1A1A"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_task_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="10sp"
                android:textColor="#888888"
                android:fontFamily="sans-serif"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Task 4 -->
        <LinearLayout
            android:id="@+id/widget_task_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <View
                android:id="@+id/widget_task_dot_4"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_low" />

            <TextView
                android:id="@+id/widget_task_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="#1A1A1A"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_task_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="10sp"
                android:textColor="#888888"
                android:fontFamily="sans-serif"
                android:visibility="gone" />

        </LinearLayout>

        <!-- No tasks placeholder -->
        <TextView
            android:id="@+id/widget_no_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Нет задач"
            android:textSize="12sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif" />

    </LinearLayout>

</LinearLayout>
