<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Date label at top -->
    <TextView
        android:id="@+id/widget_date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="Сегодня"
        android:textSize="12sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif-medium" />

    <!-- Accent dot next to date -->
    <View
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_toEndOf="@id/widget_date_text"
        android:layout_alignTop="@id/widget_date_text"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_accent_circle" />

    <!-- Large progress percentage -->
    <TextView
        android:id="@+id/widget_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="0%"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#4A90D9"
        android:fontFamily="sans-serif-medium" />

    <!-- Completed count below -->
    <TextView
        android:id="@+id/widget_completed_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_progress_text"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="2dp"
        android:text="0/0 задач"
        android:textSize="12sp"
        android:textColor="#888888"
        android:fontFamily="sans-serif" />

</RelativeLayout>
